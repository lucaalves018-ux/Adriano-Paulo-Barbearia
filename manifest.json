  "description": "Agende seu horário na Adriano Paulo Barbearia",
  "start_url": "./index.html",
  "display": "standalone",
  "background_color": "#f6f3ee",
  "theme_color": "#151515",
  "orientation": "portrait",
  "icons": [
    {
      "src": "logo.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
