      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "comprovante",
          "accept": ["image/*", "application/pdf"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "image/*": [".png", ".jpg", ".jpeg"],
        "application/pdf": [".pdf"]
      }
    }
  ]
